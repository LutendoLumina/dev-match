// Database schema: each `model` becomes a table in Postgres.
// After changing this file run `npm run db:migrate` to update the database.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile?

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Each user owns at most one profile; deleting the user deletes it.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  likesGiven    Like[] @relation("LikesGiven")
  likesReceived Like[] @relation("LikesReceived")

  @@map("profiles")
}

// "fromProfile liked toProfile". A match is two likes pointing at each other,
// so matches are derived with a query rather than stored separately.
model Like {
  id            String   @id @default(uuid()) @db.Uuid
  fromProfileId String   @db.Uuid
  toProfileId   String   @db.Uuid
  createdAt     DateTime @default(now())

  fromProfile Profile @relation("LikesGiven", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   Profile @relation("LikesReceived", fields: [toProfileId], references: [id], onDelete: Cascade)

  // One like per pair; the unique index also serves "what did I like?" lookups.
  @@unique([fromProfileId, toProfileId])
  // Serves "who liked me?" lookups when checking for a match.
  @@index([toProfileId])
  @@map("likes")
}
