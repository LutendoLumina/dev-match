// Database schema: each `model` becomes a table in Postgres.
// After changing this file run `npm run db:migrate` to update the database.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile?

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Each user owns at most one profile; deleting the user deletes it.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  likesGiven    Like[] @relation("LikesGiven")
  likesReceived Like[] @relation("LikesReceived")

  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")

  @@map("profiles")
}

// A chat message between two matched profiles.
model Message {
  id                 String    @id @default(uuid()) @db.Uuid
  senderProfileId    String    @db.Uuid
  recipientProfileId String    @db.Uuid
  body               String    @db.VarChar(2000)
  createdAt          DateTime  @default(now())
  // Null until the recipient opens the conversation.
  readAt             DateTime?

  sender    Profile @relation("MessagesSent", fields: [senderProfileId], references: [id], onDelete: Cascade)
  recipient Profile @relation("MessagesReceived", fields: [recipientProfileId], references: [id], onDelete: Cascade)

  // Loading a conversation in time order.
  @@index([senderProfileId, recipientProfileId, createdAt])
  // Counting a user's unread messages.
  @@index([recipientProfileId, readAt])
  @@map("messages")
}

// "fromProfile liked toProfile". A match is two likes pointing at each other,
// so matches are derived with a query rather than stored separately.
model Like {
  id            String   @id @default(uuid()) @db.Uuid
  fromProfileId String   @db.Uuid
  toProfileId   String   @db.Uuid
  createdAt     DateTime @default(now())

  fromProfile Profile @relation("LikesGiven", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   Profile @relation("LikesReceived", fields: [toProfileId], references: [id], onDelete: Cascade)

  // One like per pair; the unique index also serves "what did I like?" lookups.
  @@unique([fromProfileId, toProfileId])
  // Serves "who liked me?" lookups when checking for a match.
  @@index([toProfileId])
  @@map("likes")
}
